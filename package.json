{
  "name": "dramago-mcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test:media": "vitest run tests --exclude \"tests/dramago/**\"",
    "test:dramago-contracts": "node --test tests/dramago/contracts.test.mjs tests/dramago/relocation.test.mjs",
    "check:dramago-contracts": "node scripts/validate-dramago-p0.mjs && python -B packages/dramago-contracts/contracts/validate_contracts.py",
    "test:dramago": "vitest run tests/dramago --exclude \"tests/dramago/**/*.mjs\" && node --test tests/dramago/*.test.mjs tests/dramago/*.node.mjs",
    "test": "pnpm run test:media && pnpm run test:dramago"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "pg-mem": "^3.0.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
